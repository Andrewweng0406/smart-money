<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  ############################################################
  #  退役中（2026-09-10 核對）：這支服務目前沒有載入。
  #
  #  現在所有排程都跑在 Railway 的 stock-agent service 上，
  #  見 SETUP.md 第 8 節。本檔案保留為歷史參考。
  #
  #  ⚠️ 重新啟用前必讀：底下寫死的 /Users/andrewweng/stock.agent
  #     這個目錄「已經不存在」。專案現在在 ~/Desktop/smart-money，
  #     但你不能只是把路徑改成 Desktop —— Desktop 底下的背景程式
  #     會被 macOS TCC 擋掉（實測過的真問題，症狀是
  #     PermissionError: Operation not permitted）。
  #
  #     正確順序：專案先搬到 ~/ 底下的一般資料夾 → 重建 .venv
  #     → 更新本檔路徑 → 才 launchctl load。詳見 SETUP.md 第 4 節。
  ############################################################
-->
<dict>
    <key>Label</key>
    <string>com.andrewweng.stockgex-intraday</string>

    <!-- 用 run.sh --watch，不是直接呼叫 python intraday_watcher.py——
         run.sh 負責 cd 到專案目錄、activate 虛擬環境、載入 .env，這支
         plist 不用重複組這些步驟。--watch 模式本身會跳過單元測試（見
         run.sh 裡的說明），保持每次觸發的開銷夠輕量。 -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/andrewweng/stock.agent/run.sh</string>
        <string>--watch</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/andrewweng/stock.agent</string>

    <!-- 每15分鐘觸發一次（900秒），全天候都會觸發，但 intraday_watcher.py
         內部的 is_market_hours() 只允許美股股票期權正式交易時間
         09:30~16:00 ET；其他時間直接跳過、不打任何 API——StartInterval
         選的是「每N秒」而不是 StartCalendarInterval
         （那個要列出所有整點+15分的時間點，一天要列快50組，太笨重）。 -->
    <key>StartInterval</key>
    <integer>900</integer>

    <key>StandardOutPath</key>
    <string>/Users/andrewweng/Library/Logs/stockgex/stockgex-intraday.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/andrewweng/Library/Logs/stockgex/stockgex-intraday.err.log</string>
</dict>
</plist>
